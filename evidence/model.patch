+				sourceList, err = dynamicClient.ListSourcesUsingGVKs(cmd.Context(), &gvks, filters...)
+				if err != nil && dynamic.AsPartialListError(err) == nil {
 					return knerrors.GetError(err)
 				}
-			case err != nil:
